{
  "name": "jonas-os",
  "version": "1.0.0",
  "description": "Local task orchestrator with a PostgreSQL queue, Codex/Antigravity workers and an Ollama planner",
  "main": "index.js",
  "scripts": {
    "test": "npm run semantics:test && npm run chief:unit && npm run router:test && npm run capability-router:test && npm run opencode:unit && npm run repair:unit && npm run reviewer:test && npm run control-plane:test",
    "semantics:test": "tsx --test src/tasks/semantics.test.ts src/orchestration/completion.test.ts",
    "codex:test": "tsx src/test-codex.ts",
    "agy:test": "tsx src/test-antigravity.ts",
    "router:test": "tsx src/test-router.ts",
    "executor:test": "tsx src/test-execute.ts",
    "db:test": "tsx src/test-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit",
    "worker": "tsx src/worker.ts",
    "queue:test": "tsx src/test-queue.ts",
    "worktree:test": "tsx src/test-worktree.ts",
    "chief:check": "tsx src/check-chief.ts",
    "chief:unit": "tsx --test src/chief/chief.test.ts src/local/ollama.test.ts",
    "chief:test": "tsx src/test-chief.ts",
    "opencode:check": "tsx src/check-opencode.ts",
    "opencode:unit": "tsx --test src/local/opencode.test.ts",
    "opencode:test": "tsx src/test-opencode.ts",
    "capability-router:test": "tsx --test src/router/capability-router.test.ts",
    "executor:integration": "tsx src/test-worktree.ts",
    "repair:unit": "tsx --test src/chief/repair.test.ts",
    "reviewer:test": "tsx --test src/review/review.test.ts",
    "escalation:test": "tsx --test src/orchestration/integration.test.ts",
    "orchestration:test": "tsx --test src/orchestration/integration.test.ts",
    "escalations:list": "tsx src/escalations/cli.ts list",
    "escalation:answer": "tsx src/escalations/cli.ts answer",
    "task:abandon": "tsx src/escalations/cli.ts abandon",
    "repair:smoke": "tsx src/test-repair.ts",
    "control-plane:dev": "tsx src/control-plane/launcher.ts dev",
    "control-plane:fixtures": "tsx src/control-plane/launcher.ts fixtures",
    "control-plane:build": "npm run build --workspace @jonas-os/control-plane",
    "control-plane:start": "tsx src/control-plane/launcher.ts start",
    "control-plane:typecheck": "npm run typecheck --workspace @jonas-os/control-plane",
    "control-plane:lint": "npm run lint --workspace @jonas-os/control-plane",
    "control-plane:test": "tsx --test src/control-plane/*.test.ts",
    "control-plane:e2e": "playwright test --config apps/control-plane/playwright.config.ts",
    "control-plane:db:test": "tsx src/control-plane/db-integration.ts",
    "verifier:unit": "tsx --test src/verification/verifier.test.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@mastra/core": "^1.72.0",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "execa": "^10.0.1",
    "pg": "^8.23.0",
    "pg-boss": "^12.35.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "mastra": "^1.31.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "workspaces": [
    "apps/control-plane"
  ]
}
