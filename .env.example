# Local PostgreSQL from docker-compose.yml. Change for your own database.
DATABASE_URL=postgresql://jonas:jonas@127.0.0.1:5434/jonas_os

# Optional local Chief (Ollama must already have the model installed).
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_CHIEF_MODEL=qwen3.5:9b-q4_K_M
LOCAL_CHIEF_CONTEXT=16384
LOCAL_CHIEF_TIMEOUT_MS=120000

# Optional Antigravity model IDs; omit to use the CLI's default model.
# AGY_PRO_MODEL selects independent review too; macOS reviewer supports consumer OAuth.
# AGY_FLASH_MODEL=your-installed-flash-model-id
# AGY_PRO_MODEL=your-installed-pro-model-id

# Optional absolute directory outside all source repository checkouts.
# JONAS_OS_WORKTREE_DIR=/absolute/path/to/worktrees

# Volitelný OpenCode coding worker; CLI ani model se automaticky neinstalují.
# Default používá LOCAL_CHIEF_MODEL; na 16 GB stroji ponech stejný model.
LOCAL_CODING_MODEL=qwen3.5:9b-q4_K_M-jonas-16k
OPENCODE_BIN=opencode
LOCAL_CODING_CONTEXT=16384
LOCAL_CODING_TIMEOUT_MS=180000
LOCAL_CODING_MAX_DIFFICULTY=2

# Pevný limit coding pokusů: první implementace + opravy; integer 1–3.
# Efektivní limit = min(TaskSpec.maxAttempts, JONAS_OS_MAX_ATTEMPTS).
JONAS_OS_MAX_ATTEMPTS=3

# Development-only Control Plane fixtures. Použij explicitně
# npm run control-plane:fixtures; neaktivuj pro reálná data/production.
# CONTROL_PLANE_FIXTURES=0

# Volitelný bootstrap registry při čtení Control Plane: absolutní Git root
# nebo JSON pole cest. Žádné hledání adresářů; neplatné cesty se nezaregistrují.
# JONAS_OS_REPOSITORIES=/absolute/path/to/repository
# JONAS_OS_REPOSITORIES=["/absolute/path/to/first","/absolute/path/to/second"]
